    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.441.0",
    "node-sqlite3-wasm": "^0.8.61",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0",
    "zod": "^3.23.8"
  }
