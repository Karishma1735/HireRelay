{
  "name": "hirerelay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch server/src/index.js & vite client",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite client",
