# ---- Supabase (local: run `npx supabase start`, then `npx supabase status` for these) ----
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- viaSocket (Integrations -> the embed -> Install Code). Server side only. ----
VIASOCKET_ORG_ID=80251
VIASOCKET_PROJECT_ID=proj1pVRqxu9
VIASOCKET_EMBED_SECRET=
VIASOCKET_API_URL=https://flow-api.viasocket.com
VIASOCKET_RUN_URL=https://flow.sokt.io

# ---- HireRelay ----
PORT=8787
# Public URL viaSocket can reach (a tunnel in dev, your domain in production). Required for the
# Google Forms handler, which calls HireRelay from viaSocket's servers.
HIRERELAY_PUBLIC_URL=
# Any long random string; signs the per-drive ingest keys baked into viaSocket handlers.
INGEST_SECRET=
# Optional: allowed browser origin(s) for the API, comma separated.
CORS_ORIGIN=http://localhost:5173
